# Groq AI — get your key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# MongoDB — e.g. MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/firebox?retryWrites=true&w=majority

# Set automatically by Railway in production; leave unset locally
# PORT=3001
# NODE_ENV=production
