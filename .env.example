# Groq AI — get your free keys at https://console.groq.com
# Option A: single key
GROQ_API_KEY=your_groq_api_key_here
# Option B: multiple keys (comma-separated) — round-robins and auto-retries on rate limits
# GROQ_API_KEYS=key1,key2,key3

# MongoDB — e.g. MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/firebox?retryWrites=true&w=majority

# Ollama Local AI via an OpenAI-compatible endpoint. Keep values server-side.
# Local default: http://127.0.0.1:11434/v1
OLLAMA_ENDPOINT=http://127.0.0.1:11434/v1
OLLAMA_MODEL=

# Set automatically by Railway in production; leave unset locally
# PORT=3001
# NODE_ENV=production

# Optional OAuth providers for the pre-home sign-in buttons
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.example.com/api/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=https://your-domain.example.com/api/auth/github/callback
