# Cloud coding agents are separate HTTPS services. Keep provider API keys on their own Agent Servers.
GROQ_AGENT_URL=https://your-groq-agent-service.example.com
GROQ_AGENT_SECRET=your_groq_agent_shared_secret
OPENROUTER_AGENT_URL=https://your-openrouter-agent-service.example.com
OPENROUTER_AGENT_SECRET=your_openrouter_agent_shared_secret
OPENAI_AGENT_URL=https://your-openai-agent-service.example.com
OPENAI_AGENT_SECRET=your_openai_agent_shared_secret
GEMINI_AGENT_URL=https://your-gemini-agent-service.example.com
GEMINI_AGENT_SECRET=your_gemini_agent_shared_secret
CLAUDE_AGENT_URL=https://your-claude-agent-service.example.com
CLAUDE_AGENT_SECRET=your_claude_agent_shared_secret

# MongoDB — e.g. MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/firebox?retryWrites=true&w=majority

# Ollama Local AI via an OpenAI-compatible endpoint. Keep values server-side.
# Local default: http://127.0.0.1:11434/v1
OLLAMA_ENDPOINT=http://127.0.0.1:11434/v1
OLLAMA_MODEL=

# Provider API keys such as ANTHROPIC_API_KEY, GROQ_API_KEY, OPENAI_API_KEY, and GEMINI_API_KEY belong only on their matching Agent Server.
# The Firebox Main Server must receive only Agent Server URLs and shared secrets above.

# Set automatically by Railway in production; leave unset locally
# PORT=3001
# NODE_ENV=production

# Optional OAuth providers for the pre-home sign-in buttons
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.example.com/api/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=https://your-domain.example.com/api/auth/github/callback
