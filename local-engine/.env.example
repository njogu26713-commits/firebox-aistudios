# Folder where Local Firebox may create generated projects
FIREBOX_WORKSPACE=C:\Users\YourName\FireboxProjects

# Use a long random token and enter the same value in Firebox Settings
FIREBOX_ENGINE_TOKEN=replace-with-a-long-random-token-at-least-24-characters

# Local Engine HTTP port
FIREBOX_ENGINE_PORT=8787

# Local Ollama OpenAI-compatible API
OLLAMA_ENDPOINT=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3:0.6b
OLLAMA_API_KEY=
